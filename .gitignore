# 一条 `logs/` 盖住两层，测试日志不再单独列。
logs/
.ruff_cache

# 旧版 runner 曾经把每套的 stdout/stderr 写在仓库根。已经不这么写了，
# 留着这两条只为兜住老副本 —— 根目录要是再冒出 `_run_*.out` 说明有人
# 改回去了。
_run_*.out
_run_*.err

